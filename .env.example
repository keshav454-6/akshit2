# FraudGuard AI Environment Configuration

PROJECT_NAME="FraudGuard AI"
TAGLINE="Detect Before You Pay. Protect Every Transaction."
VERSION="1.0.0"

# Secret Key for JWT Authentication
SECRET_KEY="fraudguard-super-secret-jwt-key-2026-production-ready"

# Database Configuration (PostgreSQL primary with SQLite local fallback)
# For SQLite local development:
DATABASE_URL="sqlite:///./fraudguard.db"

# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fraudguard"

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Frontend Vite Configuration
VITE_API_URL="http://localhost:8000/api/v1"
VITE_WS_URL="ws://localhost:8000/ws/stream"

